# Site configuration
# Copy this file to config.env and edit the values for your domain.
# config.env is gitignored — your local changes will never be committed.
#
# All subdomains (smtp, www, etc.) are derived from DOMAIN automatically.
DOMAIN=example.org
WEB_ROOT=/var/www/html
NGINX_CONF=/etc/nginx/sites-available/default

# Certbot contact email (for expiry notifications, ToS agreement)
CERTBOT_EMAIL=admin@example.org
